(kicad_wks
	(version 20231118)
	(generator "pl_editor")
	(generator_version "8.0")
	(setup
		(textsize 1.5 1.5)
		(linewidth 0.15)
		(textlinewidth 0.15)
		(left_margin 10)
		(right_margin 10)
		(top_margin 10)
		(bottom_margin 10)
	)
	(rect
		(name "")
		(start 110.269 48.26)
		(end 2 2)
		(comment "rect around the title block")
	)
	(rect
		(name "")
		(start 0 0 ltcorner)
		(end 0 0)
		(repeat 2)
		(incrx 2)
		(incry 2)
	)
	(line
		(name "")
		(start 50 2 ltcorner)
		(end 50 0 ltcorner)
		(repeat 30)
		(incrx 50)
	)
	(tbtext "1"
		(name "")
		(pos 25 1 ltcorner)
		(font
			(size 1.3 1.3)
		)
		(repeat 100)
		(incrx 50)
	)
	(line
		(name "")
		(start 50 2 lbcorner)
		(end 50 0 lbcorner)
		(repeat 30)
		(incrx 50)
	)
	(tbtext "1"
		(name "")
		(pos 25 1 lbcorner)
		(font
			(size 1.3 1.3)
		)
		(repeat 100)
		(incrx 50)
	)
	(line
		(name "")
		(start 0 50 ltcorner)
		(end 2 50 ltcorner)
		(repeat 30)
		(incry 50)
	)
	(tbtext "A"
		(name "")
		(pos 1 25 ltcorner)
		(font
			(size 1.3 1.3)
		)
		(justify center)
		(repeat 100)
		(incry 50)
	)
	(line
		(name "")
		(start 0 50 rtcorner)
		(end 2 50 rtcorner)
		(repeat 30)
		(incry 50)
	)
	(tbtext "A"
		(name "")
		(pos 1 25 rtcorner)
		(font
			(size 1.3 1.3)
		)
		(justify center)
		(repeat 100)
		(incry 50)
	)
	(tbtext "Date: ${ISSUE_DATE}"
		(name "")
		(pos 87 6.9002)
	)
	(line
		(name "")
		(start 110 5.5002)
		(end 2 5.5002)
	)
	(tbtext "${KICAD_VERSION}"
		(name "")
		(pos 109 4.1002)
		(comment "Kicad version")
	)
	(line
		(name "")
		(start 110 8.5002)
		(end 2 8.5002)
	)
	(tbtext "Rev: ${REVISION}"
		(name "")
		(pos 26.54 6.9002)
		(font bold)
	)
	(tbtext "Size: ${PAPER}"
		(name "")
		(pos 109 6.9002)
		(comment "Paper format name")
	)
	(tbtext "Sheet: ${#}/${##}"
		(name "")
		(pos 26.54 4.1002)
		(comment "Sheet id")
	)
	(line
		(name "")
		(start 110 12.5002)
		(end 2 12.5002)
	)
	(tbtext "Title: ${TITLE}"
		(name "")
		(pos 109 10.7002)
		(font
			(size 2 2) bold italic)
	)
	(tbtext "File: ${FILENAME}"
		(name "")
		(pos 109 14.3002)
	)
	(line
		(name "")
		(start 110 18.5002)
		(end 2 18.5002)
	)
	(tbtext "Sheet: ${SHEETPATH}"
		(name "")
		(pos 109 17.0002)
	)
	(tbtext "${COMPANY}"
		(name "")
		(pos 109 20.0002)
		(font bold)
		(comment "Company name")
	)
	(tbtext "${COMMENT1}"
		(name "")
		(pos 109 23.0002)
		(comment "Comment 0")
	)
	(tbtext "${COMMENT2}"
		(name "")
		(pos 109 26.0002)
		(comment "Comment 1")
	)
	(tbtext "${COMMENT3}"
		(name "")
		(pos 109 29.0002)
		(comment "Comment 2")
	)
	(tbtext "${COMMENT4}"
		(name "")
		(pos 109 32.0002)
		(comment "Comment 3")
	)
	(line
		(name "")
		(start 90 8.5002)
		(end 90 5.5002)
	)
	(line
		(name "")
		(start 28.54 8.5002)
		(end 28.54 2.0002)
	)
	(rect
		(name "")
		(start 232.41 48.26)
		(end 110.269 2)
	)
	(rect
		(name "")
